@startuml pkm-des-admin-review-sequence
autonumber
actor "Registrar / Admin" as Admin
participant "Browser" as Browser
participant "Server Action" as Action
participant "Supabase Client" as Supabase
database "PostgreSQL" as DB

Admin -> Browser : Views pending enrollments
Browser -> Supabase : Queries enrollments (status=PENDING)
Supabase -> DB : Select
DB --> Supabase : Results
Supabase --> Browser : Displays Table

opt Applicable Health Record Update and assigned Nurse
  Admin -> Browser : Opens Health Record Verification
  Browser -> Action : verifyHealthRequirementWithSignature(enrollment_id, drawn_png)
  Action -> Supabase : RPC verify_health_requirement_with_signature(...)
  Supabase -> DB : Locks enrollment and requirement
  DB -> DB : Verifies exact applicability and inserts immutable Nurse signature
  DB -> DB : Marks requirement VERIFIED and Health Clearance SIGNED atomically
  DB -> DB : Inserts Nurse audit row
end

Admin -> Browser : Clicks "Approve" (or "Reject")
Browser -> Action : reviewEnrollmentAction(id, decision, remarks)
Action -> Supabase : RPC review_enrollment(id, decision, reviewer_id, remarks)

Supabase -> DB : Executes atomic RPC
DB -> DB : Selects enrollment FOR UPDATE (Stale concurrent review protection)
alt if status is not PENDING
    DB --> Supabase : Error (Already reviewed)
else
    opt Applicable current-term Health Record Update
      DB -> DB : Reads status-only requirement and current Nurse fingerprint
      alt requirement/signature is not current
        DB --> Supabase : Error (Unverified or unsigned Health Clearance)
      end
    end
    DB -> DB : Updates enrollment status to APPROVED/REJECTED
    DB -> DB : Updates student enrollment_status to ENROLLED (if approved)
    DB -> DB : Inserts into audit_logs
    DB --> Supabase : Success
end

note right of DB
  Health Record Update applies only to an
  Incoming 1st Year Student with an explicitly
  confirmed Female official-record value.
  No medical details or uploaded forms are stored.
end note

Supabase --> Action : Result
Action --> Browser : Success / Revalidate Table

@enduml
