# Application and Vercel runtime variables. Use only a dedicated fictional-data
# Supabase preview project for deployment. Keep server-only values private.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Database provider:
# - supabase: production and Vercel deployment
# - sqlite: local development only
DATABASE_PROVIDER=supabase

# Server-only key used by the account creation server action to create Supabase Auth users.
# Keep this secret out of the browser and out of version control.
# Required for production/Vercel until the official generated-password email workflow is replaced.
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-only Gmail SMTP account-setup email delivery. Keep disabled
# unless the authorized PKM mailbox and a Google App Password are configured.
EMAIL_DELIVERY_ENABLED=false
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
EMAIL_FROM=
APP_BASE_URL=http://localhost:3000

# Server-only HMAC secret for the short-lived account-claim proof. Use at least
# 32 random characters. Never expose this through a NEXT_PUBLIC_* variable.
ACCOUNT_CLAIM_SECRET=

# Local demo-reset variables. Keep these out of Vercel and version control.
# This bootstrap password is only for resetting fictional demo Auth users.
DEMO_STUDENT_PASSWORD=

# Optional. Supply the existing internal Registrar/Admin email privately when
# reviewed demo enrollments should reference that profile. Do not commit it.
DEMO_REGISTRAR_EMAIL=

# Required by the explicit demo reset command. Set this to RESET_PKM_DES_DEMO
# only for an intended preview/test database. The reset also requires the
# server-only SUPABASE_SERVICE_ROLE_KEY. Never commit real values.
DEMO_RESET_CONFIRM=

# Local preview-credential variables. Keep these out of Vercel and version control.
PREVIEW_EXPECTED_SUPABASE_HOST=
PREVIEW_REGISTRAR_EMAIL=
PREVIEW_REGISTRAR_PASSWORD=
# Required only with: npm run preview:credentials:prepare -- --apply
PREVIEW_CREDENTIALS_CONFIRM=
