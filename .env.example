NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Database provider:
# - supabase: production and Vercel deployment
# - sqlite: local development only
DATABASE_PROVIDER=supabase

# Server-only key used by the account creation server action to create Supabase Auth users.
# Keep this secret out of the browser and out of version control.
# Required for production/Vercel until the official generated-password email workflow is replaced.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only HMAC secret for the short-lived account-claim proof. Use at least
# 32 random characters. Never expose this through a NEXT_PUBLIC_* variable.
ACCOUNT_CLAIM_SECRET=

# Fictional demonstration-data tooling only. This password is used only to create
# fictional demo Auth users and must never be committed with a real value.
DEMO_STUDENT_PASSWORD=

# Optional. Supply the existing internal Registrar/Admin email privately when
# reviewed demo enrollments should reference that profile. Do not commit it.
DEMO_REGISTRAR_EMAIL=

# Required by the explicit demo reset command. Set this to RESET_PKM_DES_DEMO
# only for an intended preview/test database. The reset also requires the
# server-only SUPABASE_SERVICE_ROLE_KEY. Never commit real values.
DEMO_RESET_CONFIRM=
