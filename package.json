{
  "name": "pkm-des",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-vercel-env.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:production-env": "node scripts/check-production-env.mjs",
    "test:deployment-env": "node --test scripts/deployment/*.test.mjs",
    "test:smoke-env": "node --test scripts/smoke/*.test.mjs",
    "test:smoke:public": "playwright test tests/smoke/public.spec.ts",
    "test:smoke:workflow": "node --env-file-if-exists=.env.smoke.local scripts/smoke/run-demo-workflow.mjs",
    "test:portal-navigation": "tsx --import ./tests/support/stub-loader.mjs --test components/layout/portal-navigation.test.tsx",
    "test:enrollment-review-ui": "tsx --import ./tests/support/stub-loader.mjs --test components/admin/enrollment-review-controls.test.tsx",
    "test:email": "tsx --conditions react-server --test lib/email/*.test.ts",
    "db:sqlite:init": "node scripts/sqlite/init-dev-db.mjs",
    "demo:reset": "node scripts/demo/reset-demo-data.mjs",
    "demo:verify": "node scripts/demo/verify-demo-data.mjs",
    "demo:test": "node --test scripts/demo/*.test.mjs",
    "preview:credentials:prepare": "node --env-file-if-exists=.env.local scripts/preview-credentials/prepare-preview-credentials.mjs",
    "preview:credentials:verify": "node --env-file-if-exists=.env.local scripts/preview-credentials/verify-preview-credentials.mjs",
    "preview:credentials:test": "node --test scripts/preview-credentials/*.test.mjs",
    "test:account-claim": "tsx --test lib/account-claim/*.test.ts",
    "test:student-enrollment": "tsx --test lib/enrollment/*.test.ts",
    "test:enrollment-reporting": "tsx --test lib/enrollment/reporting.test.ts",
    "test:admin-enrollment-review": "tsx --test lib/enrollment/admin-review.test.ts",
    "test:admin-student-records": "tsx --conditions react-server --test lib/admin-student-records/*.test.ts",
    "test:registration-form": "tsx --test lib/registration-form/presentation.test.ts",
    "test:signatures": "tsx --test lib/signatures/*.test.ts lib/official-roles/*.test.ts",
    "test:signature-ui": "tsx --import ./tests/support/stub-loader.mjs --test components/signatures/e-signature-input.test.tsx"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.3",
    "nodemailer": "^9.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.61.1",
    "@types/jsdom": "21.1.7",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "jsdom": "24.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "xlsx": "^0.18.5"
  }
}
